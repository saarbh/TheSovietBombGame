/* Main Menu Stylesheet — Petrov Soviet Retro Theme */

.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #0a0a12;
    justify-content: space-between;
    align-items: center;
    padding: 40px;
    position: relative;
}

.header-container {
    align-items: center;
    margin-top: 50px;
}

.game-title-label {
    font-size: 84px;
    color: #f0f0f0;
    -unity-font-style: bold;
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.subtitle-label {
    font-size: 22px;
    color: #d4a017;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.buttons-container {
    width: 380px;
    align-items: stretch;
    justify-content: center;
    margin-top: auto;
    margin-bottom: auto;
    transition-duration: 0.3s;
    transition-property: opacity;
}

.menu-button {
    height: 56px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: #141a24;
    border-color: #2d5a27;
    border-width: 2px;
    border-radius: 4px;
    color: #e0e0e0;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, scale;
}

.menu-button:hover {
    background-color: #2d5a27;
    border-color: #d4a017;
    color: #ffffff;
    scale: 1.04 1.04;
}

.menu-button:active {
    background-color: #c41e3a;
    border-color: #ffffff;
    color: #ffffff;
    scale: 0.98 0.98;
}

.footer-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
}

.version-label {
    font-size: 14px;
    color: #7a828e;
}

.credits-label {
    font-size: 14px;
    color: #7a828e;
}

/* Scanline & Vignette */
.scanline-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 5, 0, 0.08);
}

.vignette-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.25);
}

/* Options Modal */
.options-modal {
    position: absolute;
    width: 780px;
    max-height: 85%;
    background-color: #10151f;
    border-color: #2d5a27;
    border-width: 2px;
    border-radius: 8px;
    padding: 30px;
    align-items: center;
    justify-content: space-between;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

.options-title {
    font-size: 32px;
    color: #d4a017;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.options-scroll {
    width: 100%;
    flex-grow: 1;
    margin-bottom: 20px;
}

.section-title {
    font-size: 20px;
    color: #2d5a27;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 15px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-color: #2d5a27;
    padding-bottom: 4px;
}

/* Volume Sliders */
.slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-vertical: 6px;
}

.slider-label {
    font-size: 16px;
    color: #e0e0e0;
    width: 160px;
}

.volume-slider {
    flex-grow: 1;
    margin-left: 10px;
}

.volume-value-label {
    font-size: 16px;
    color: #d4a017;
    width: 50px;
    -unity-text-align: middle-right;
}

/* Keymap Table */
.keymap-container {
    width: 100%;
    margin-top: 5px;
}

.keymap-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-vertical: 6px;
    padding-horizontal: 10px;
    background-color: #171f2c;
    margin-vertical: 3px;
    border-radius: 4px;
}

.keymap-action-label {
    font-size: 16px;
    color: #e0e0e0;
}

.key-badge {
    background-color: #2d5a27;
    color: #ffffff;
    border-radius: 4px;
    padding-horizontal: 10px;
    padding-vertical: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.key-badge-btn {
    background-color: #2d5a27;
    color: #ffffff;
    border-radius: 4px;
    padding-horizontal: 12px;
    padding-vertical: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-width: 1px;
    border-color: transparent;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
}

.key-badge-btn:hover {
    background-color: #3e7b36;
    border-color: #d4a017;
    scale: 1.05 1.05;
}

.key-badge-btn:active {
    background-color: #c41e3a;
    border-color: #ffffff;
    scale: 0.95 0.95;
}

.key-badge-btn.waiting {
    background-color: #c41e3a;
    color: #ffffff;
    border-color: #ffffff;
}

/* Loading Overlay */
.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #0a0a12;
    align-items: center;
    justify-content: center;
    padding: 60px;
}

.loading-title {
    font-size: 32px;
    color: #d4a017;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 40px;
}

.progress-bar-container {
    width: 600px;
    height: 24px;
    background-color: #141a24;
    border-color: #2d5a27;
    border-width: 2px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 15px;
}

.loading-progress-fill {
    width: 0%;
    height: 100%;
    background-color: #2d5a27;
    transition-duration: 0.1s;
}

.loading-status-container {
    flex-direction: row;
    justify-content: space-between;
    width: 600px;
    margin-bottom: 40px;
}

.loading-status-text {
    font-size: 16px;
    color: #f0f0f0;
    letter-spacing: 1px;
}

.loading-percent-text {
    font-size: 16px;
    color: #d4a017;
    -unity-font-style: bold;
}

.loading-footer {
    font-size: 12px;
    color: #7a828e;
    letter-spacing: 2px;
    position: absolute;
    bottom: 30px;
}

/* Hidden Utility Class */
.hidden {
    display: none;
}
